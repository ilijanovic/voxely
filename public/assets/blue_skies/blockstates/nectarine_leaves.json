{
	"multipart": [
		{
			"when": { "mature": "false" },
			"apply": { "model": "blue_skies:nectarine_leaves_0" }
		},
		{
			"when": { "mature": "true" },
			"apply": { "model": "blue_skies:nectarine_leaves" }
		},
        {
			"when": { "snowy": "true" },
            "apply": { "model": "blue_skies:blueskies_leaves_snowy" }
        }
    ]
}
